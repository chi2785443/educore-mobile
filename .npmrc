public-hoist-pattern[]=react-native-css-interop
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
# Babel plugins are resolved by name at bundle time (expo-router/entry.js), so
# they must sit in the root node_modules. Without this, EAS local builds — which
# reinstall into a temp dir — fail with
# "Cannot find module '@babel/plugin-transform-react-jsx'".
public-hoist-pattern[]=*babel*
